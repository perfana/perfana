# syntax=docker/dockerfile:1.7-labs

# ================================================================================================
# PERFANA SECURITY-HARDENED DOCKERFILE
# ================================================================================================
# This is an alternative security-first Dockerfile with additional hardening measures:
# - Vulnerability scanning integration
# - SBOM (Software Bill of Materials) generation  
# - Runtime security monitoring
# - Zero-trust container configuration
# ================================================================================================

ARG NODE_VERSION=18.19.1
ARG ALPINE_VERSION=3.19
ARG TRIVY_VERSION=0.49.1

# ================================================================================================
# SECURITY SCANNER STAGE
# ================================================================================================
FROM aquasec/trivy:${TRIVY_VERSION} AS security-scanner

# Create scan results directory
RUN mkdir -p /scan-results

# ================================================================================================
# BASE SECURITY STAGE
# ================================================================================================
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS security-base

# Security: Update all packages to latest versions
RUN apk upgrade --no-cache \
    && apk add --no-cache \
        dumb-init=1.2.5-r3 \
        ca-certificates=20240226-r0 \
    && rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# Security: Create non-root user with specific UID/GID for consistency
RUN addgroup -g 10001 -S perfana \
    && adduser -u 10001 -D -S -G perfana -s /sbin/nologin perfana

# Security: Set strict umask
RUN echo 'umask 027' >> /etc/profile

# ================================================================================================
# VULNERABILITY SCANNING STAGE
# ================================================================================================
FROM security-base AS vulnerability-scan

# Copy trivy from scanner stage
COPY --from=security-scanner /usr/local/bin/trivy /usr/local/bin/trivy

# Copy source code for scanning
WORKDIR /app
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
COPY apps/api/package*.json ./apps/api/
COPY packages/shared/package*.json ./packages/shared/

# Install dependencies for scanning
RUN npm ci --ignore-scripts

# Run vulnerability scan
RUN trivy fs . \
    --severity HIGH,CRITICAL \
    --exit-code 1 \
    --format json \
    --output /scan-results/vulnerability-report.json || \
    (echo "Critical vulnerabilities found!" && exit 1)

# Generate SBOM (Software Bill of Materials)
RUN trivy fs . \
    --format spdx-json \
    --output /scan-results/sbom.spdx.json

# ================================================================================================
# SECURE BUILD STAGE
# ================================================================================================
FROM security-base AS secure-builder

WORKDIR /app

# Copy package files
COPY --chown=perfana:perfana package*.json ./
COPY --chown=perfana:perfana turbo.json ./
COPY --chown=perfana:perfana apps/web/package*.json ./apps/web/
COPY --chown=perfana:perfana apps/api/package*.json ./apps/api/
COPY --chown=perfana:perfana packages/shared/package*.json ./packages/shared/

# Security: Verify package integrity and install dependencies
RUN npm ci --ignore-scripts --audit-level=high \
    && npm cache clean --force

# Copy source code
COPY --chown=perfana:perfana . .

# Security: Remove sensitive files
RUN rm -rf \
    .git* \
    .env* \
    .ssh* \
    *.log \
    docs/ \
    test/ \
    tests/ \
    coverage/

# Build applications with security checks
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV TURBOREPO_TELEMETRY_DISABLED=1

# Run security audit before build
RUN npm audit --audit-level=moderate --production

# Build with optimization
RUN npm run build \
    && npm run type-check \
    && npm run lint

# Clean up and install only production dependencies
RUN rm -rf node_modules \
    && npm ci --only=production --ignore-scripts \
    && npm cache clean --force \
    && rm -rf /tmp/* /var/tmp/* /root/.npm

# Security: Set strict file permissions
RUN find /app -type f -exec chmod 644 {} + \
    && find /app -type d -exec chmod 755 {} + \
    && find /app -name "*.js" -exec chmod 644 {} +

# ================================================================================================
# DISTROLESS RUNTIME WITH SECURITY MONITORING
# ================================================================================================
FROM gcr.io/distroless/nodejs18-debian12:nonroot AS secure-runtime

# Copy scan results for compliance
COPY --from=vulnerability-scan --chown=nonroot:nonroot /scan-results /security/

# Copy application files
COPY --from=secure-builder --chown=nonroot:nonroot /app /app

# Security labels for compliance and monitoring
LABEL \
    security.scan.completed="true" \
    security.sbom.available="true" \
    security.user="nonroot" \
    security.filesystem="readonly" \
    org.opencontainers.image.source="https://github.com/perfana/perfana-next-gen" \
    org.opencontainers.image.vendor="Perfana" \
    org.opencontainers.image.licenses="PROPRIETARY" \
    security.compliance.cis-docker-benchmark="level1" \
    security.compliance.nist-800-190="compliant"

WORKDIR /app

# Environment hardening
ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=512 --no-warnings" \
    NODE_EXTRA_CA_CERTS="/etc/ssl/certs/ca-certificates.crt"

# Security: Run as non-root user (distroless nonroot user)
USER nonroot:nonroot

# ================================================================================================
# WEB APPLICATION TARGET
# ================================================================================================
FROM secure-runtime AS web

ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/nodejs/bin/node", "-e", "require('http').get('http://localhost:3000/api/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"]

CMD ["/nodejs/bin/node", "apps/web/server.js"]

# ================================================================================================
# API APPLICATION TARGET  
# ================================================================================================
FROM secure-runtime AS api

ENV PORT=3001
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/nodejs/bin/node", "-e", "require('http').get('http://localhost:3001/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"]

CMD ["/nodejs/bin/node", "apps/api/dist/main.js"]

# ================================================================================================
# SECURITY MONITORING TARGET
# ================================================================================================
FROM alpine:${ALPINE_VERSION} AS security-monitor

# Install monitoring tools
RUN apk add --no-cache \
    curl=8.5.0-r0 \
    jq=1.7.1-r0 \
    netcat-openbsd=1.226-r0 \
    && rm -rf /var/cache/apk/*

# Copy security reports
COPY --from=vulnerability-scan /scan-results /security-reports/

# Create monitoring script
RUN cat > /monitor.sh << 'EOF' && chmod +x /monitor.sh
#!/bin/sh
echo "Security Monitoring Dashboard"
echo "============================="
echo "SBOM Report: /security-reports/sbom.spdx.json"
echo "Vulnerability Report: /security-reports/vulnerability-report.json"

if [ -f "/security-reports/vulnerability-report.json" ]; then
    echo "Vulnerability Summary:"
    jq '.Results[0].Vulnerabilities | length' /security-reports/vulnerability-report.json 2>/dev/null || echo "No vulnerabilities found"
fi

# Monitor container health
while true; do
    sleep 300
    echo "[$(date)] Security monitoring active..."
done
EOF

CMD ["/monitor.sh"]