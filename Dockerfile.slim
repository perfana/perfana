# syntax=docker/dockerfile:1.7-labs

# ================================================================================================
# PERFANA NEXT-GEN - SLIM DOCKERFILE
# ================================================================================================
# Focus on drastically reducing image size while maintaining functionality
# ================================================================================================

ARG NODE_VERSION=18.19.1

# ================================================================================================
# STAGE 1: Build Stage (Full Alpine with all dependencies)
# ================================================================================================
FROM node:${NODE_VERSION}-alpine AS builder

# Install build dependencies
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files
COPY package*.json turbo.json ./
COPY apps/web/package*.json ./apps/web/
COPY apps/api/package*.json ./apps/api/
COPY packages/shared/package*.json ./packages/shared/

# Install dependencies
RUN npm ci

# Copy source and build
COPY . .
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Install only production dependencies
RUN rm -rf node_modules && npm ci --only=production

# ================================================================================================
# STAGE 2: Minimal Runtime (Distroless)
# ================================================================================================
FROM gcr.io/distroless/nodejs18-debian12:nonroot AS web

WORKDIR /app

# Copy only the absolute minimum needed to run Next.js
COPY --from=builder --chown=nonroot:nonroot /app/apps/web/.next ./apps/web/.next
COPY --from=builder --chown=nonroot:nonroot /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nonroot:nonroot /app/apps/web/package.json ./apps/web/package.json

# Copy only essential node_modules for Next.js runtime
COPY --from=builder --chown=nonroot:nonroot /app/node_modules/next ./node_modules/next
COPY --from=builder --chown=nonroot:nonroot /app/node_modules/react ./node_modules/react
COPY --from=builder --chown=nonroot:nonroot /app/node_modules/react-dom ./node_modules/react-dom

# Copy shared package build output
COPY --from=builder --chown=nonroot:nonroot /app/packages/shared/dist ./packages/shared/dist

# Environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

# Security labels
LABEL org.opencontainers.image.title="Perfana Web (Slim)" \
      security.non-root="true"

# Start Next.js
WORKDIR /app/apps/web
CMD ["/nodejs/bin/node", "../../node_modules/next/dist/bin/next", "start"]

# ================================================================================================
# STAGE 3: API Runtime (Distroless)  
# ================================================================================================
FROM gcr.io/distroless/nodejs18-debian12:nonroot AS api

WORKDIR /app

# Copy API build output
COPY --from=builder --chown=nonroot:nonroot /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nonroot:nonroot /app/packages/shared/dist ./packages/shared/dist

# Copy minimal NestJS dependencies
COPY --from=builder --chown=nonroot:nonroot /app/node_modules/@nestjs ./node_modules/@nestjs
COPY --from=builder --chown=nonroot:nonroot /app/node_modules/reflect-metadata ./node_modules/reflect-metadata
COPY --from=builder --chown=nonroot:nonroot /app/node_modules/rxjs ./node_modules/rxjs

# Environment
ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

# Security labels  
LABEL org.opencontainers.image.title="Perfana API (Slim)" \
      security.non-root="true"

# Start API
CMD ["/nodejs/bin/node", "apps/api/dist/main.js"]