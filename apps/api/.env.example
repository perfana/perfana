# Perfana API Environment Variables

# Application Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=perfana
DB_PASSWORD=your_secure_password
DB_NAME=perfana
DB_SSL=false

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=perfana-prod
KEYCLOAK_CLIENT_ID=perfana-api
KEYCLOAK_CLIENT_SECRET=your_client_secret
KEYCLOAK_POLICY_ENFORCEMENT=PERMISSIVE
KEYCLOAK_TOKEN_VALIDATION=ONLINE

# Redis Configuration (for BullMQ, realtime features, and API key caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# API Key Cache Configuration
# Enable/disable API key caching with Redis (true/false)
API_KEY_CACHE_ENABLED=true

# Cache TTL in seconds
# - Development: 300 (5 minutes) - faster invalidation for testing
# - Production: 600 (10 minutes) - balance performance vs freshness
# - High Traffic: 900 (15 minutes) - maximize cache hit rate
API_KEY_CACHE_TTL_SECONDS=600

# Stale Test Run Detection Configuration
# Time in minutes after which a test run is considered stale if no updates are received
# Default: 2 minutes
STALE_TIMEOUT_MINUTES=2

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4001
FRONTEND_URL=http://localhost:4001

# Logging
LOG_LEVEL=info

# Encryption Key for Sensitive Data
# Used to encrypt/decrypt Grafana credentials, API keys, and other sensitive data stored in database
# MUST be a 64-character hex string (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Keep this secret! Do NOT commit the actual key to version control
ENCRYPTION_KEY=your_64_character_hex_encryption_key_goes_here_generate_new_one

# Admin Log Viewer (default off). When enabled, mount the Docker socket read-only
# on your deployment's api service: /var/run/docker.sock:/var/run/docker.sock:ro
# It grants perfana-admin users log-read of all Perfana containers.
#
# The api image runs as a non-root (distroless) user, but the mounted socket is
# usually root-owned mode 660 — so the process gets EACCES and the container
# list comes back empty. Grant the api access to the socket's group, e.g. in
# compose:  group_add: ["0"]   (0 = the socket's group; use the docker gid on
# hosts where the socket is docker-group-owned). Running the api as root works
# too but is broader than needed.
#
# LOG_VIEWER_COMPOSE_PROJECT must match your compose project name (usually the
# deploy directory name, e.g. "perfana"), or the container list comes back empty.
LOG_VIEWER_ENABLED=false
LOG_VIEWER_COMPOSE_PROJECT=perfana
