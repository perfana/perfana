{
  "name": "@perfana/api",
  "version": "0.1.0",
  "private": true,
  "description": "Perfana NestJS API backend",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch & sleep 3 && nodemon dist/main.js",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings 300",
    "pretest": "ts-node --project tsconfig.setup.json -r tsconfig-paths/register src/test/setup-database.ts",
    "test": "jest",
    "test:unit": "jest --config jest.unit.config.js",
    "test:watch": "jest --watch --no-coverage",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "migration:run": "npx ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "npx ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "migration:show": "npx ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:show -d src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^10.4.20",
    "@socket.io/redis-adapter": "^8.3.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.5.0",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "csv-parse": "^6.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "joi": "^18.0.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "puppeteer": "^24.36.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "safe-regex": "^2.1.1",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.27",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@nestjs/cli": "^10.2.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.2.0",
    "@testcontainers/postgresql": "^11.11.0",
    "@testcontainers/redis": "^11.11.0",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/passport-jwt": "^3.0.12",
    "@types/pg": "^8.15.5",
    "@types/safe-regex": "^1.1.6",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0"
  }
}
