exports[`MetricsService: SQL for a panel with no series grouping is pinned getMetricTimeSeries query builder calls for a label, title, metric name and ramp-up exclusion 2`] = `
[
  [
    "select",
    [
      [
        "m.time",
        "m.metric_name",
        "m.value",
        "m.timestep",
        "m.ramp_up",
        "m.unit",
      ],
    ],
  ],
  [
    "where",
    [
      "m.test_run_id = :testRunId",
      {
        "testRunId": "run-1",
      },
    ],
  ],
  [
    "andWhere",
    [
      "m.dashboard_label = :dashboardLabel",
      {
        "dashboardLabel": "Perf",
      },
    ],
  ],
  [
    "andWhere",
    [
      "m.panel_title = :panelTitle",
      {
        "panelTitle": "RT",
      },
    ],
  ],
  [
    "orderBy",
    [
      "m.metric_name",
    ],
  ],
  [
    "addOrderBy",
    [
      "m.time",
    ],
  ],
  [
    "andWhere",
    [
      "m.metric_name = :metricName",
      {
        "metricName": "T01.login",
      },
    ],
  ],
  [
    "andWhere",
    [
      "m.ramp_up = false",
    ],
  ],
]
`;
