// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`MetricsService: SQL for a panel with no series grouping is pinned findDSMetricsForPanel downsampled path: existence probe, series count and lttb() 1`] = `
[
  [
    "SELECT EXISTS (
          SELECT 1 FROM (
            SELECT 1 FROM ds_metrics WHERE test_run_id = $1 AND panel_id = $2 AND application_dashboard_id = $3 AND metric_name = $4 LIMIT 4001 OFFSET 4000
          ) sub
        ) as needs_downsampling",
    [
      "run-1",
      201,
      "dash-1",
      "T01.login",
    ],
  ],
  [
    "SELECT COUNT(DISTINCT metric_name)::int AS count FROM ds_metrics WHERE test_run_id = $1 AND panel_id = $2 AND application_dashboard_id = $3 AND metric_name = $4",
    [
      "run-1",
      201,
      "dash-1",
      "T01.login",
    ],
  ],
  [
    "
        SELECT
          sub.metric_name,
          (sub.dp).time AS time,
          (sub.dp).value AS value
        FROM (
          SELECT
            metric_name,
            unnest(lttb("time", value, 2000)) AS dp
          FROM ds_metrics
          WHERE test_run_id = $1 AND panel_id = $2 AND application_dashboard_id = $3 AND metric_name = $4
          GROUP BY metric_name
        ) sub
        ORDER BY sub.metric_name, (sub.dp).time
      ",
    [
      "run-1",
      201,
      "dash-1",
      "T01.login",
    ],
  ],
]
`;

