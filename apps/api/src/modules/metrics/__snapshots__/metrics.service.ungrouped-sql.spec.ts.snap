exports[`MetricsService: SQL for a panel with no series grouping is pinned findDSMetricsForPanel regular path, metrics source, metric name and zoom window 1`] = `
[
  [
    "SELECT EXISTS (
          SELECT 1 FROM (
            SELECT 1 FROM ds_metrics WHERE test_run_id = $1 AND panel_id = $2 AND metrics_source_id = $3 AND metric_name = $4 AND "time" >= $5::timestamptz AND "time" <= $6::timestamptz LIMIT 4001 OFFSET 4000
          ) sub
        ) as needs_downsampling",
    [
      "run-1",
      201,
      "ms-1",
      "T01.login",
      "2024-01-01T00:00:00.000Z",
      "2024-01-01T01:00:00.000Z",
    ],
  ],
]
`;

