import { DatabaseTestHelper } from '../utils/database-test-helper';
import { TestDataFactory } from '../utils/test-data-factory';

describe('Database Operations Integration Tests', () => {
  let testContext: any;

  beforeAll(async () => {
    testContext = await DatabaseTestHelper.setupTestEnvironment();
  });

  afterAll(async () => {
    await DatabaseTestHelper.teardownTestEnvironment();
  });

  describe('User Operations', () => {
    test('should create and retrieve users consistently', async () => {
      const userData = TestDataFactory.createDeterministicUser('-integration');
      userData.passwordHash = 'hashedPassword123';

      const result = await DatabaseTestHelper.compareOperation(
        'createUser',
        () => testContext.nativeService.createUser(userData)
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult).toBeDefined();
      expect(result.nativeResult.email).toBe(userData.email);
      expect(result.duration).toBeLessThan(1000);
    });

    test('should find users by email', async () => {
      const email = 'test.user-integration@regression.test';

      const result = await DatabaseTestHelper.compareOperation(
        'findUserByEmail',
        () => testContext.nativeService.findUserByEmail(email)
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult?.email).toBe(email);
    });

    test('should update user information', async () => {
      const user = await testContext.nativeService.findUserByEmail('test.user-integration@regression.test');
      const updateData = { firstName: 'Updated', lastLogin: new Date() };

      const result = await DatabaseTestHelper.compareOperation(
        'updateUser',
        () => testContext.nativeService.updateUser(user.id, updateData)
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult.firstName).toBe('Updated');
      expect(result.nativeResult.lastLogin).toBeDefined();
    });
  });

  describe('Test Run Operations', () => {
    let createdUser: any;

    beforeEach(async () => {
      createdUser = await testContext.nativeService.findUserByEmail('test.user-integration@regression.test');
    });

    test('should create test runs with proper validation', async () => {
      const testRunData = TestDataFactory.createDeterministicTestRun('-integration');
      testRunData.createdBy = createdUser.id;

      const result = await DatabaseTestHelper.compareOperation(
        'createTestRun',
        () => testContext.nativeService.createTestRun(testRunData)
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult.testRunId).toBe(testRunData.testRunId);
      expect(result.nativeResult.createdBy).toBe(createdUser.id);
    });

    test('should retrieve test runs with filters', async () => {
      const filters = {
        applicationName: 'regression-app-integration',
        environment: 'test',
      };

      const result = await DatabaseTestHelper.compareOperation(
        'getTestRunsWithFilters',
        () => testContext.nativeService.getTestRuns(filters)
      );

      expect(result.success).toBe(true);
      expect(Array.isArray(result.nativeResult)).toBe(true);
      expect(result.nativeResult.length).toBeGreaterThan(0);
    });

    test('should find test run by testRunId', async () => {
      const testRunId = 'regression-test-run-integration';

      const result = await DatabaseTestHelper.compareOperation(
        'getTestRunByTestRunId',
        () => testContext.nativeService.getTestRunByTestRunId(testRunId)
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult?.testRunId).toBe(testRunId);
    });

    test('should update test run status and metadata', async () => {
      const testRun = await testContext.nativeService.getTestRunByTestRunId('regression-test-run-integration');
      const updateData = {
        status: 'failed' as const,
        notes: 'Integration test failure',
        metadata: { ...testRun.metadata, testType: 'integration' },
      };

      const result = await DatabaseTestHelper.compareOperation(
        'updateTestRun',
        () => testContext.nativeService.updateTestRun(testRun.id, updateData)
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult.status).toBe('failed');
      expect(result.nativeResult.notes).toBe('Integration test failure');
      expect(result.nativeResult.metadata.testType).toBe('integration');
    });
  });

  describe('API Key Operations', () => {
    let createdUser: any;

    beforeEach(async () => {
      createdUser = await testContext.nativeService.findUserByEmail('test.user-integration@regression.test');
    });

    test('should create and validate API keys', async () => {
      const apiKeyData = TestDataFactory.createDeterministicApiKey('-integration');
      apiKeyData.createdBy = createdUser.id;

      const createResult = await DatabaseTestHelper.compareOperation(
        'createApiKey',
        () => testContext.nativeService.createApiKey(apiKeyData)
      );

      expect(createResult.success).toBe(true);
      expect(createResult.nativeResult.key).toBe(apiKeyData.key);

      // Test finding the API key
      const findResult = await DatabaseTestHelper.compareOperation(
        'findApiKeyByKey',
        () => testContext.nativeService.findApiKeyByKey(apiKeyData.key)
      );

      expect(findResult.success).toBe(true);
      expect(findResult.nativeResult?.user.id).toBe(createdUser.id);
    });

    test('should update API key usage statistics', async () => {
      const apiKey = await testContext.nativeService.findApiKeyByKey(
        TestDataFactory.createDeterministicApiKey('-integration').key
      );

      const result = await DatabaseTestHelper.compareOperation(
        'updateApiKeyUsage',
        () => testContext.nativeService.updateApiKeyUsage(apiKey.id)
      );

      expect(result.success).toBe(true);

      // Verify usage was updated
      const updatedApiKey = await testContext.nativeService.findApiKeyByKey(apiKey.key);
      expect(updatedApiKey.lastUsed).toBeDefined();
    });
  });

  describe('Configuration Operations', () => {
    let testRun: any;

    beforeEach(async () => {
      testRun = await testContext.nativeService.getTestRunByTestRunId('regression-test-run-integration');
    });

    test('should create single configuration', async () => {
      const configData = TestDataFactory.createDeterministicConfiguration(
        'integration.test.config',
        'integration-value'
      );
      configData.testRunId = testRun.id;

      const result = await DatabaseTestHelper.compareOperation(
        'createTestRunConfiguration',
        () => testContext.nativeService.createTestRunConfiguration(configData)
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult.key).toBe(configData.key);
      expect(result.nativeResult.value).toBe(configData.value);
    });

    test('should create multiple configurations in batch', async () => {
      const configs = [
        TestDataFactory.createDeterministicConfiguration('batch.config.1', 'value1'),
        TestDataFactory.createDeterministicConfiguration('batch.config.2', 'value2'),
        TestDataFactory.createDeterministicConfiguration('batch.config.3', 'value3'),
      ].map(config => ({ ...config, testRunId: testRun.id }));

      const result = await DatabaseTestHelper.compareOperation(
        'createMultipleTestRunConfigurations',
        () => testContext.nativeService.createMultipleTestRunConfigurations(configs)
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult.length).toBe(3);
      expect(result.nativeResult[0].key).toBe('batch.config.1');
    });

    test('should retrieve configurations for test run', async () => {
      const result = await DatabaseTestHelper.compareOperation(
        'getTestRunConfigurations',
        () => testContext.nativeService.getTestRunConfigurations(testRun.id)
      );

      expect(result.success).toBe(true);
      expect(Array.isArray(result.nativeResult)).toBe(true);
      expect(result.nativeResult.length).toBeGreaterThan(0);
    });
  });

  describe('Data Integrity and Relationships', () => {
    test('should maintain referential integrity across all entities', async () => {
      // Create a complete data set with relationships
      const { user, testRuns, apiKey, configurations } = await DatabaseTestHelper.setupRegressionData(
        testContext.nativeService
      );

      // Validate all relationships
      expect(testRuns.every(tr => tr.createdBy === user.id)).toBe(true);
      expect(apiKey.createdBy).toBe(user.id);
      expect(configurations.every(c => testRuns.some(tr => tr.id === c.testRunId))).toBe(true);

      // Test data integrity validation
      const validation = DatabaseTestHelper.validateDataIntegrity({
        users: [user],
        testRuns,
        configurations,
        apiKeys: [apiKey],
      });

      expect(validation.isValid).toBe(true);
      expect(validation.errors).toHaveLength(0);
    });

    test('should handle concurrent operations without data corruption', async () => {
      const user = await testContext.nativeService.findUserByEmail('test.user-integration@regression.test');

      // Create multiple test runs concurrently
      const promises = Array.from({ length: 5 }, (_, i) => {
        const testRunData = TestDataFactory.createTestRun({
          testRunId: `concurrent-test-${i}-${Date.now()}`,
          applicationName: 'concurrent-test',
          environment: 'test',
          createdBy: user.id,
        });
        return testContext.nativeService.createTestRun(testRunData);
      });

      const results = await Promise.allSettled(promises);
      const successful = results.filter(r => r.status === 'fulfilled');

      expect(successful.length).toBe(5);

      // Verify all test runs were created properly
      const testRuns = await testContext.nativeService.getTestRuns({
        applicationName: 'concurrent-test',
      });
      expect(testRuns.length).toBeGreaterThanOrEqual(5);
    });
  });

  describe('Performance Benchmarks', () => {
    test('should perform user operations within performance thresholds', async () => {
      const performanceTest = await DatabaseTestHelper.measurePerformance(
        async () => {
          const userData = TestDataFactory.createUser();
          userData.passwordHash = 'hashedPassword123';
          const user = await testContext.nativeService.createUser(userData);
          await testContext.nativeService.findUserByEmail(user.email);
          return user;
        },
        10
      );

      expect(performanceTest.averageDuration).toBeLessThan(200); // 200ms average
      expect(performanceTest.results).toHaveLength(10);
    });

    test('should handle bulk operations efficiently', async () => {
      const bulkTest = await DatabaseTestHelper.measurePerformance(
        async () => {
          const configs = Array.from({ length: 10 }, (_, i) => ({
            testRunId: 'regression-test-run-integration',
            key: `bulk.test.${i}`,
            value: `bulk-value-${i}`,
            category: 'performance',
            isSensitive: false,
          }));

          return testContext.nativeService.createMultipleTestRunConfigurations(configs);
        },
        5
      );

      expect(bulkTest.averageDuration).toBeLessThan(500); // 500ms for 10 configs
      expect(bulkTest.results.every(r => r.length === 10)).toBe(true);
    });
  });

  describe('Error Handling and Edge Cases', () => {
    test('should handle duplicate email creation gracefully', async () => {
      const userData = TestDataFactory.createUser({
        email: 'duplicate@test.com',
        passwordHash: 'hashedPassword123',
      });

      // Create first user
      await testContext.nativeService.createUser(userData);

      // Attempt to create duplicate
      await expect(testContext.nativeService.createUser(userData)).rejects.toThrow();
    });

    test('should handle non-existent record queries', async () => {
      const result = await DatabaseTestHelper.compareOperation(
        'findNonExistentUser',
        () => testContext.nativeService.findUserByEmail('nonexistent@test.com')
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult).toBeNull();
    });

    test('should validate required fields', async () => {
      const invalidUserData = {
        // Missing required fields
        firstName: 'Test',
      };

      await expect(
        testContext.nativeService.createUser(invalidUserData as any)
      ).rejects.toThrow();
    });

    test('should handle malformed API key lookups', async () => {
      const result = await DatabaseTestHelper.compareOperation(
        'findMalformedApiKey',
        () => testContext.nativeService.findApiKeyByKey('invalid-key-format')
      );

      expect(result.success).toBe(true);
      expect(result.nativeResult).toBeNull();
    });
  });
});