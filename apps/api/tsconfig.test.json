{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "rootDir": ".",
    "strictNullChecks": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitAny": false
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "exclude": []
}