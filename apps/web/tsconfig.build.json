{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "lib/**/*",
    "hooks/**/*",
    "contexts/**/*",
    "components/layout/**/*",
    "app/*.tsx",
    "types/**/*"
  ],
  "exclude": ["node_modules", "app/test-runs/**/*", "app/systems/**/*", "app/settings/**/*", "app/integrations/**/*", "__tests__/**/*", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"]
}
