# Environment Configuration
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (matches API and grafana-sync services)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=perfana_native

# Grafana API Configuration
# Note: Grafana URL and API token come from grafana_instances table in database
GRAFANA_CONCURRENCY=30
GRAFANA_BATCH_SIZE=20

# pg-boss Queue Configuration
QUEUE_CONCURRENCY=10
QUEUE_RETRY_LIMIT=3
QUEUE_RETRY_DELAY=30

# Performance Tuning
DB_POOL_SIZE=50
METRICS_BATCH_SIZE=200

# Optional: Dynatrace Configuration
DYNATRACE_URL=
DYNATRACE_API_TOKEN=

# Encryption Configuration
# Encryption Key for Sensitive Data
# Used to encrypt/decrypt Grafana credentials, API keys, and other sensitive data stored in database
# MUST be a 64-character hex string (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Keep this secret! Do NOT commit the actual key to version control
# IMPORTANT: Must match the same key used in API and Grafana-Sync services
ENCRYPTION_KEY=your_64_character_hex_encryption_key_goes_here_generate_new_one