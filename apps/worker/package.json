{
  "name": "@perfana/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Perfana DS Next-Gen Worker Application - Pipeline Processing",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest --config vitest.integration.config.ts run",
    "test:real-world": "vitest run src/test/integration/real-world --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:all": "npm run test:unit && npm run test:integration",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "reset-stuck-statuses": "tsx src/utils/resetStuckStatuses.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "ci": "npm run type-check && npm run lint && npm run test:unit && npm run build"
  },
  "keywords": [
    "perfana",
    "performance-testing",
    "pipeline",
    "worker",
    "node.js"
  ],
  "author": "Perfana Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.2.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "@perfana/shared": "file:../../packages/shared",
    "bullmq": "^5.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.2.2",
    "ioredis": "^5.8.0",
    "pg": "^8.11.3",
    "pino": "^8.16.1",
    "pino-pretty": "^10.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27",
    "undici": "^7.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@nestjs/testing": "^10.2.0",
    "@testcontainers/postgresql": "^11.11.0",
    "@testcontainers/redis": "^11.11.0",
    "@types/node": "^20.8.7",
    "@types/pg": "^8.10.7",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "eslint": "^8.52.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pg-mem": "^2.6.13",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.3",
    "testcontainers": "^10.2.1",
    "tsx": "^4.0.0",
    "typescript": "^5.2.2",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
