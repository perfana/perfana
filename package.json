{
  "name": "perfana",
  "version": "0.2.93.1",
  "private": true,
  "description": "Open-source performance analysis platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@perfana/grafana-sync --filter=!@perfana/perfana-report",
    "dev:all": "turbo run dev",
    "dev:api": "turbo run dev --filter=@perfana/api",
    "dev:web": "turbo run dev --filter=@perfana/web",
    "dev:grafana-sync": "turbo run dev --filter=@perfana/grafana-sync",
    "dev:perfana-report": "turbo run dev --filter=@perfana/perfana-report",
    "lint": "turbo run lint",
    "seed": "tsx scripts/seed.ts",
    "preflight": "turbo run lint type-check && node scripts/check-entity-migrations.mjs && npm run test:rls --workspace=@perfana/api",
    "check:entity-migrations": "node scripts/check-entity-migrations.mjs",
    "check:schema-constraints": "node scripts/check-schema-constraints.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "turbo run test",
    "test:coverage": "cd apps/api && npm test -- --coverage && cd ../.. && cd apps/web && npm test -- --coverage && cd ../.. && cd apps/grafana-sync && npm test -- --coverage && cd ../.. && cd apps/worker && npm test -- --coverage && cd ../..",
    "fix-coverage-paths": "./fix-coverage-paths.sh",
    "sonar:scan": "./run-sonar-scan.sh",
    "sonar:baseline": "npm run test:coverage && npm run fix-coverage-paths && ./run-sonar-scan.sh",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "knip": "knip",
    "migration:generate": "cd packages/shared && typeorm migration:generate -d ormconfig.js",
    "migration:run": "cd packages/shared && typeorm migration:run -d ormconfig.js",
    "migration:revert": "cd packages/shared && typeorm migration:revert -d ormconfig.js",
    "migration:show": "cd packages/shared && typeorm migration:show -d ormconfig.js"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "^1.55.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "brace-expansion": "^1.1.11",
    "knip": "^6.3.0",
    "prettier": "^3.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.0.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "glob": "^10.5.0",
    "jws": "^3.2.3",
    "validator": "^13.15.22",
    "qs": "^6.14.0",
    "js-yaml": "^4.1.1",
    "ioredis": "5.10.1",
    "basic-ftp": "^5.2.0",
    "axios": "^1.16.1",
    "ws": "^8.21.0",
    "webpack": "^5.104.1",
    "multer": "^2.2.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    }
  }
}
